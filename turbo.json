{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_URL",
    "BETTER_AUTH_TRUSTED_ORIGINS",
    "DATABASE_URL",
    "NIMBUS_DATA_ROOT",
    "NIMBUS_CONFIG_ROOT",
    "NIMBUS_HOMES_PATH",
    "PORT",
    "NIMBUS_TRUSTED_PROXIES",
    "NIMBUS_AUDIT_RETENTION_DAYS",
    "NIMBUS_SMTP_HOST",
    "NIMBUS_SMTP_PORT",
    "NIMBUS_SMTP_SECURITY",
    "NIMBUS_SMTP_USER",
    "NIMBUS_SMTP_PASSWORD",
    "NIMBUS_SMTP_FROM",
    "NIMBUS_OIDC_ISSUER",
    "NIMBUS_OIDC_CLIENT_ID",
    "NIMBUS_OIDC_CLIENT_SECRET",
    "NIMBUS_OIDC_NAME",
    "NIMBUS_OIDC_AUTO_PROVISION",
    "NIMBUS_OIDC_GROUPS_CLAIM",
    "NIMBUS_BACKUP_KEEP",
    "NIMBUS_MCP_ENABLED",
    "NIMBUS_WATCH_DEBOUNCE_MS",
    "PUID",
    "PGID",
    "UMASK",
    "NIMBUS_E2E_PORT"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "test": {},
    "dev": {
      "cache": false
    },
    "typecheck": {
      "outputs": []
    },
    "//#typecheck:root": {
      "inputs": ["tsconfig.json", "scripts/**", "playwright.config.ts"],
      "outputs": []
    }
  }
}
