{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_URL",
    "DATABASE_URL",
    "BETTER_AUTH_TRUSTED_ORIGINS",
    "NIMBUS_DATA_ROOT",
    "NIMBUS_CONFIG_ROOT",
    "PORT"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        ".next/**"
      ]
    },
    "lint": {},
    "test": {},
    "dev": {
      "cache": false
    },
    "typecheck": {}
  }
}
