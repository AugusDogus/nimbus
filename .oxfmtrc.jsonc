{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  // Matches the style most of the code already had: 80 columns, double quotes, semicolons,
  // trailing commas and two-space indentation.
  "printWidth": 80,
  "tabWidth": 2,
  "useTabs": false,
  "singleQuote": false,
  "jsxSingleQuote": false,
  "semi": true,
  "trailingComma": "all",
  "arrowParens": "always",
  "bracketSpacing": true,
  "endOfLine": "lf",
  // Sorting would reorder code rather than only lay it out; keep it off.
  "sortImports": false,
  "sortTailwindcss": false,
  "sortPackageJson": false,
  // .gitignore is honored too, so build output, node_modules and bun.lock are skipped.
  "ignorePatterns": [
    // Generated by drizzle-kit: SQL migrations and their schema snapshots.
    "apps/web/drizzle/**",
    // Generated by the TanStack Router plugin.
    "apps/web/client/route-tree.gen.ts",
    // Fluid Functionalism's registry files, kept as shipped (see .oxlintrc.jsonc).
    "apps/web/components/ui/button.tsx",
    "apps/web/components/ui/tooltip.tsx",
    "apps/web/components/ui/scroll-area.tsx",
    "apps/web/components/ui/sidebar.tsx",
    "apps/web/components/ui/sidebar-core.tsx",
    "apps/web/components/ui/sidebar-menu.tsx",
    "apps/web/components/ui/select.tsx",
    "apps/web/lib/elevated.tsx",
    "apps/web/lib/popup.ts",
    "apps/web/hooks/use-keyboard-nav-gate.ts",
    "apps/web/components/ui/checkbox.tsx",
    "apps/web/components/ui/switch.tsx",
    "apps/web/components/ui/input.tsx",
    "apps/web/components/ui/textarea.tsx",
    "apps/web/components/ui/field.tsx",
    "apps/web/components/fluid-hover-highlight.tsx",
    "apps/web/hooks/use-fluid-hover.ts",
    "apps/web/hooks/use-touch-primary.tsx",
    "apps/web/lib/font-weight.ts",
    "apps/web/lib/icon-context.tsx",
    "apps/web/lib/key-cap.tsx",
    "apps/web/lib/omit.ts",
    "apps/web/lib/shape-context.tsx",
    "apps/web/lib/size-context.tsx",
    "apps/web/lib/springs.ts",
    "apps/web/lib/surface-classes.ts",
    "apps/web/lib/surface-context.tsx",
    "apps/web/lib/type-scale.ts",
    // Prose, including vendored agent skills; formatting it would only rewrap text.
    "**/*.md",
    "**/*.mdc",
  ],
}
