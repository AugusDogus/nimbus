{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  // Matches the style most of the code already had: 80 columns, double quotes, semicolons,
  // trailing commas and two-space indentation.
  "printWidth": 80,
  "tabWidth": 2,
  "useTabs": false,
  "singleQuote": false,
  "jsxSingleQuote": false,
  "semi": true,
  "trailingComma": "all",
  "arrowParens": "always",
  "bracketSpacing": true,
  "endOfLine": "lf",
  // Sorting would reorder code rather than only lay it out; keep it off.
  "sortImports": false,
  "sortTailwindcss": false,
  "sortPackageJson": false,
  // .gitignore is honored too, so build output, node_modules and bun.lock are skipped.
  "ignorePatterns": [
    // Generated by drizzle-kit: SQL migrations and their schema snapshots.
    "apps/web/drizzle/**",
    // Generated by the TanStack Router plugin.
    "apps/web/client/route-tree.gen.ts",
    // Prose, including vendored agent skills; formatting it would only rewrap text.
    "**/*.md",
    "**/*.mdc",
  ],
}
