{
  "name": "nimbus",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --deny-warnings",
    "test": "bun test",
    "test:e2e": "bun playwright test",
    "setup": "bun scripts/setup.ts",
    "start": "bun run --cwd apps/web start",
    "typecheck": "turbo typecheck"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@playwright/test": "^1.58.2",
    "@types/bun": "^1.4.4",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2007",
    "shadcn": "^3.8.2",
    "turbo": "^2.8.1"
  }
}
