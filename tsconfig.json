{
  // Root scripts and the Playwright config. The workspaces have their own tsconfig files.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["bun"]
  },
  "include": ["scripts/**/*.ts", "playwright.config.ts"]
}
