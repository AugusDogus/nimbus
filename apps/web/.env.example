# Prefer `bun run setup` from the repository root to generate apps/web/.env.
# For manual setup, replace the placeholder with `openssl rand -base64 32` output.
BETTER_AUTH_SECRET=REPLACE_WITH_RANDOM_SECRET
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000
# Relative to apps/web when running locally. Docker uses /data.
NIMBUS_DATA_ROOT=./data
# Optional app state directory. Local default: <data root>/.nimbus. Docker: /config.
# NIMBUS_CONFIG_ROOT=/absolute/path/to/config
# Optional. Defaults to <config root>/db.sqlite.
# DATABASE_URL=file:/absolute/path/to/nimbus.sqlite
# Optional. Defaults to 3000. Update both origins when changing the public port.
# PORT=3000
# Optional. Reverse proxy addresses or CIDR ranges whose X-Forwarded-For is trusted.
# NIMBUS_TRUSTED_PROXIES=127.0.0.1
# Optional. Days to keep audit log entries (30 to 36500). Defaults to 365.
# NIMBUS_AUDIT_RETENTION_DAYS=365
# Optional password reset email. Off unless NIMBUS_SMTP_HOST and NIMBUS_SMTP_FROM are set.
# NIMBUS_SMTP_HOST=smtp.example.com
# NIMBUS_SMTP_PORT=587
# NIMBUS_SMTP_SECURITY=starttls
# NIMBUS_SMTP_USER=nimbus@example.com
# NIMBUS_SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
# NIMBUS_SMTP_FROM=Nimbus <nimbus@example.com>
# Optional single sign-on through one OpenID Connect provider. Off unless the issuer,
# client ID, and client secret are set. Redirect URI: <BETTER_AUTH_URL>/api/auth/callback/oidc
# NIMBUS_OIDC_ISSUER=https://id.example.com/application/o/nimbus
# NIMBUS_OIDC_CLIENT_ID=nimbus
# NIMBUS_OIDC_CLIENT_SECRET=REPLACE_WITH_CLIENT_SECRET
# NIMBUS_OIDC_NAME=Authentik
# NIMBUS_OIDC_AUTO_PROVISION=false
# NIMBUS_OIDC_GROUPS_CLAIM=groups
# Optional. Set to false to turn off the MCP server for AI clients. Defaults to true.
# NIMBUS_MCP_ENABLED=true
